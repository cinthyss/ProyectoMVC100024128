@{
    ViewData["Title"] = "Inicio";
}

<!-- Estilos CSS integrados directamente para garantizar el diseño -->
<style>
    /* Estilos Generales */
    body {
        background-color: #fcf8f6 !important;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    /* Banner Principal de Ancho Completo */
    .hero-banner {
        background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), 
                    url('https://images.unsplash.com/photo-1560066984-138dadb4c035?w=1600') center/cover no-repeat;
        min-height: 450px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #ffffff !important;
        padding: 40px 20px;
        margin-bottom: 40px;
    }

    .hero-banner h1 {
        color: #ffffff !important;
        font-size: 3.2rem;
        font-weight: 700;
        margin-bottom: 15px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    }

    .hero-banner p {
        color: #f8f9fa !important;
        font-size: 1.3rem;
        max-width: 700px;
        margin: 0 auto 25px auto;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
    }

    .btn-reserva {
        background-color: #e76f51;
        color: #ffffff !important;
        padding: 12px 30px;
        font-size: 1.1rem;
        font-weight: bold;
        border-radius: 30px;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 4px 10px rgba(231, 111, 81, 0.4);
        transition: all 0.3s ease;
    }

    .btn-reserva:hover {
        background-color: #f4a261;
        transform: translateY(-2px);
    }

    /* Título de la sección */
    .section-title {
        text-align: center;
        margin-bottom: 40px;
    }

    .section-title h2 {
        font-size: 2.2rem;
        color: #2b2b2b;
        font-weight: 700;
    }

    .section-title p {
        color: #6c757d;
        font-size: 1.1rem;
    }

    .divider {
        width: 80px;
        height: 4px;
        background-color: #e76f51;
        margin: 10px auto;
        border-radius: 2px;
    }

    /* Rejilla de Tarjetas */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        padding: 0 40px 50px 40px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .card-item {
        background: #ffffff;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .card-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }

    .card-item img {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }

    .card-body-custom {
        padding: 25px;
        text-align: center;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-body-custom h3 {
        color: #212529;
        font-size: 1.5rem;
        margin-bottom: 12px;
        font-weight: 600;
    }

    .card-body-custom p {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .btn-card {
        background-color: transparent;
        color: #e76f51 !important;
        border: 2px solid #e76f51;
        padding: 8px 20px;
        border-radius: 20px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-card:hover {
        background-color: #e76f51;
        color: #ffffff !important;
    }
</style>

<!-- Banner Superior -->
<div class="hero-banner">
    <div>
        <h1>Estética & Studio Beauty</h1>
        <p>Realza tu belleza natural con nuestros tratamientos de clase mundial y estilistas profesionales.</p>
        <a href="/Productos" class="btn-reserva">Ver Catálogo de Servicios</a>
    </div>
</div>

<!-- Título de Sección -->
<div class="section-title">
    <h2>Nuestros Servicios Exclusivos</h2>
    <p>Descubre todo lo que tenemos para consentirte</p>
    <div class="divider"></div>
</div>

<!-- Tarjetas de Servicios en Rejilla de Ancho Completo -->
<div class="services-grid">
    <!-- Servicio 1 -->
    <div class="card-item">
        <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?w=600" alt="Corte & Peinado">
        <div class="card-body-custom">
            <div>
                <h3>Corte & Peinado</h3>
                <p>Asesoría de imagen personalizada y diseño de corte adaptado a las tendencias actuales.</p>
            </div>
            <div>
                <a href="/Productos" class="btn-card">Ver Detalles</a>
            </div>
        </div>
    </div>

    <!-- Servicio 2 -->
    <div class="card-item">
        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600" alt="Colorimetría & Tinte">
        <div class="card-body-custom">
            <div>
                <h3>Colorimetría & Tinte</h3>
                <p>Especialistas en Balayage, mechas, efectos de luz y tintes completos con hidratación.</p>
            </div>
            <div>
                <a href="/Productos" class="btn-card">Ver Detalles</a>
            </div>
        </div>
    </div>

    <!-- Servicio 3 -->
    <div class="card-item">
        <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?w=600" alt="Manicura & Uñas">
        <div class="card-body-custom">
            <div>
                <h3>Manicura & Uñas</h3>
                <p>Cuidado integral de manos, uñas esculturales, acrílico y gelish de larga duración.</p>
            </div>
            <div>
                <a href="/Productos" class="btn-card">Ver Detalles</a>
            </div>
        </div>
    </div>
</div>
